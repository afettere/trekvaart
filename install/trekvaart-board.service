# The Trekvaart board as a system service running as the runtime user, the same shape as
# Machinist's two services. Installed by the bootstrap at /etc/systemd/system/.
#
#   systemctl enable --now trekvaart-board.service      # as root
#   systemctl status trekvaart-board.service
#   journalctl -u trekvaart-board.service -f
#
# Localhost only, like Machinist's UI: reach it over the SSH tunnel (install/README.md).
[Unit]
Description=Trekvaart board (read-only, 127.0.0.1:7332)
After=network.target machinist-control-plane.service

[Service]
Type=simple
User=machinist
Group=machinist
WorkingDirectory=/home/machinist/trekvaart
Environment=HOME=/home/machinist
Environment=PATH=/home/machinist/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/machinist/.local/bin/node /home/machinist/trekvaart/board/server.mjs --listen 127.0.0.1:7332 --refresh-seconds 60
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
