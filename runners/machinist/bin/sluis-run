#!/usr/bin/env bash
# The executor wrapper Machinist runs instead of the bare agent CLI.
#
#   sluis-run <agent command and flags...>
#
# 1. Asks the spend sluis whether the ceiling still has room. If not, exits 75 before the
#    agent starts; Machinist records a failed run and the issue keeps its queued label for a
#    human to look at.
# 2. Turns the agent CLI's own background-task ceiling off. In --print mode the CLI ends
#    background subagents 600 s after the orchestrator's turn ends and exits; flight 3 died
#    there, ten minutes into a build reach. Machinist's `timeout` is the only wall clock.
# 3. Reads the issue the runner rendered into the prompt and leaves a marker for the
#    stranded-flight sweeper while the agent runs (a kill takes this whole process group,
#    marker cleanup included, which is exactly what the sweeper looks for).
# 4. Runs the agent with the prompt on stdin and tees its stream through `record`, which
#    appends a provisional priced row at every result event and a final row at exit.
# 5. On the agent's own exit, asks the sweeper for a verdict. An exit 0 with the issue at
#    verifying and the foreman's PR comment posted is a turn that ended inside the automation
#    gate (the first product flight left two minutes into a 50-minute CI wait): the agent is
#    run again with the same prompt, up to MAX_RESUMES times, each resume priced as its own
#    run. Anything else still in flight is a strand: the label moves to needs-human with a
#    stop comment naming the exit.
# The agent's own exit code is the wrapper's exit code.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
sluis="${here}/../../../sluis/spend-ceiling.mjs"
stranded="${here}/../../../sluis/stranded.mjs"

# Test seams only: the committed ceiling and the default marker directory are what a box uses.
ceiling_args=()
if [[ -n "${TREKVAART_CEILING:-}" ]]; then ceiling_args=(--config "${TREKVAART_CEILING}"); fi
active_dir="${TREKVAART_ACTIVE_DIR:-${HOME}/.trekvaart/active}"

if [[ $# -eq 0 ]]; then
  echo "sluis-run: no agent command given" >&2
  exit 64
fi

model=""
for arg in "$@"; do
  case "$arg" in
    --model=*) model="${arg#--model=}" ;;
  esac
done
if [[ -z "$model" ]]; then
  echo "sluis-run: the agent command must carry --model=<id> so the run can be priced" >&2
  exit 64
fi

run_id="${MACHINIST_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$}"
MAX_RESUMES=3

node "$sluis" check "${ceiling_args[@]}"

# The CLI's background-task ceiling, off (see 2 above).
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0

# The prompt arrives on stdin and is passed to the agent unchanged; a copy is read for the
# issue URL Machinist renders ("Complete https://github.com/OWNER/REPO/issues/N"). That
# line is the work request; the rest of the rendered prompt is the foreman text, whose own
# header links other issues, so the FIRST URL in the file is the wrong one (the first flight
# keyed its marker on the prompt's provenance link). Read the request line, then the
# <prompt> block, and never the file at large.
prompt_file="$(mktemp)"
cat > "$prompt_file"
issue_re='https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[0-9]+'
issue_url="$(grep -oE "^Complete ${issue_re}" "$prompt_file" | head -n 1 | sed 's/^Complete //' || true)"
if [[ -z "$issue_url" ]]; then
  issue_url="$(sed -n '/<prompt>/,/<\/prompt>/p' "$prompt_file" | grep -oE "$issue_re" | head -n 1 || true)"
fi
issue_number=""
if [[ -n "$issue_url" ]]; then issue_number="${issue_url##*/}"; fi

marker=""
if [[ -n "$issue_number" ]]; then
  mkdir -p "$active_dir"
  marker="${active_dir}/${issue_number}.json"
  printf '{"issue":%s,"pid":%s,"runId":"%s","startedAt":"%s","url":"%s"}\n' \
    "$issue_number" "$$" "$run_id" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$issue_url" > "$marker"
fi

cleanup() {
  rm -f "$prompt_file"
  if [[ -n "$marker" ]]; then rm -f "$marker"; fi
}
trap cleanup EXIT

resumes=0
while true; do
  this_run="$run_id"
  if [[ "$resumes" -gt 0 ]]; then this_run="${run_id}-r${resumes}"; fi

  set +e
  MACHINIST_RUN_ID="$this_run" "$@" < "$prompt_file" | node "$sluis" record --run-id "$this_run" --model "$model" "${ceiling_args[@]}"
  status=("${PIPESTATUS[@]}")
  set -e

  agent_status="${status[0]}"
  record_status="${status[1]}"

  if [[ "$record_status" -ne 0 ]]; then
    echo "sluis-run: the ledger row was not written (record exited ${record_status})" >&2
    exit "$record_status"
  fi

  # The agent has exited on its own (a kill never reaches this line). Ask what that means.
  if [[ -z "$issue_url" ]]; then break; fi
  verdict="$(node "$stranded" repair --issue "$issue_url" --exit "$agent_status" --run-id "$this_run" \
    --resume-budget "$((MAX_RESUMES - resumes))" --resumed "$resumes")" || {
    echo "sluis-run: the stranded-label repair failed; the sweeper will retry on its next tick" >&2
    break
  }
  if [[ "$verdict" != "resume" ]]; then break; fi
  resumes=$((resumes + 1))
  echo "sluis-run: resuming the agent for ${issue_url} (resume ${resumes} of ${MAX_RESUMES})" >&2
done

exit "$agent_status"
